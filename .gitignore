# ==== Secrets - NEVER commit these ====
.env
*.env
!.env.example
**/secrets/
**/*credentials*

# ==== Python ====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# ==== Node (if ever added) ====
node_modules/

# ==== Uploaded / generated data ====
**/uploads/*
!**/uploads/.gitkeep
**/vector_store/*
!**/vector_store/.gitkeep
# ==== Logs ====
*.log
logs/

# ==== OS / Editor ====
.DS_Store
Thumbs.db
.vscode/
.idea/

# ==== Large model files ====
*.gguf
*.bin
*.safetensors


# ==== Alembic (keep migrations, ignore local sqlite test artifacts) ====
*.sqlite3
*.db
