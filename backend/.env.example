# =============================================================
# RRASE College AI Assistant - Environment Configuration Template
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# =============================================================

# --- Application ---
APP_ENV=development
APP_NAME=RRASE College AI Assistant
SECRET_KEY=change_me_to_a_long_random_string
DEBUG=true

# --- Database (PostgreSQL) ---
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+psycopg://rrase_user:change_me@localhost:5432/rrase_college_ai

# --- JWT / Auth (used starting Phase 2) ---
JWT_SECRET_KEY=change_me_to_a_different_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Providers ---
# Primary: Ollama, running locally or on the college server. No API key needed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional fallback: only used if Ollama is unreachable AND this key is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

AI_REQUEST_TIMEOUT_SECONDS=30

# --- Vector Store / RAG ---
VECTOR_DB_PATH=./vector_store
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.15

# --- Official website import ---
COLLEGE_WEBSITE_URL=https://rrase.com/

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# --- CORS ---
# Comma-separated list of allowed origins for local development
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
